# Default development server with a local test mail spool.
APP_MODE=development
PORT=3000
HOST=127.0.0.1
DATA_DIR=./var
# Required outside development. Exact HTTPS origin, e.g. https://example.com
APP_ORIGIN=
# Required for live email authentication and password recovery. Verify the sender domain.
MAIL_API_KEY=
MAIL_FROM=
# Set a random server-only secret of at least 32 characters to enable first admin setup.
OWNER_SETUP_TOKEN=
OWNER_EMAIL={{BRUMBRUM_SOURCE_RESTORE_OWNER_EMAIL_776E2D9C}}
# Exact HTTPS origins, comma-separated, for dealer-supplied photo imports.
IMPORT_IMAGE_ORIGINS=
# Optional HTTPS destination for the JCB ad. Leave empty to display the banner without a link.
JCB_AD_URL=
# Temporary secret for provisioning advertising originals in the hosted asset bucket.
AD_CAROUSEL_MEDIA_TOKEN=
# Enable indexing only when a reviewed public deployment is ready.
PUBLIC_INDEXING=0
# Required public deployment data. May also be edited in the admin panel.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Voluntary one-time support. Leave disabled until the live Stripe account,
# matching Payment Links and checkout mode have been reviewed.
# See STRIPE.md. All values below remain server-side.
STRIPE_SUPPORT_ENABLED=0
STRIPE_SUPPORT_MODE=live
# hosted_links opens only the reviewed public Payment Links; tracked verifies sessions and webhooks.
STRIPE_SUPPORT_CHECKOUT=tracked
STRIPE_RESTRICTED_KEY=
STRIPE_ACCOUNT_ID=
# Public Stripe event receiver origin (HTTPS). Use the same inbox token on both servers.
STRIPE_WEBHOOK_ORIGIN=
STRIPE_INBOX_TOKEN=
# Used only if the application itself serves a publicly accessible signed webhook.
STRIPE_WEBHOOK_SECRET=
# ISO timestamp of the actual tax review, never a substitute for doing that review.
STRIPE_TAX_REVIEWED_AT=
# URLs keyed by package ID; missing packages stay off in hosted_links mode.
STRIPE_LIVE_PAYMENT_LINKS=
STRIPE_TEST_PAYMENT_LINKS=
# For hosted sandbox only, the exact HTTPS origin of the sandbox application.
STRIPE_SANDBOX_ORIGIN=

# Usługi i automatyzacja ogłoszeń
IMPORT_SECRET_KEY=
IMPORT_PUBLIC_ORIGIN=
IMPORT_PRIVATE_SITE_DISPATCH=
IMPORT_TICK_SECRET=
IMPORT_CHANNELS=[]
IMPORT_TICK_MS=10000
SERVICES_AI_ACCOUNT=
SERVICES_AI_TOKEN=
